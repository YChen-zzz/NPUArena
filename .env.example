# Default: local SQLite database at data/npuarena.sqlite3 (no configuration needed).
# NPUARENA_DB_PATH=data/npuarena.sqlite3

# Deployment: set this to a PostgreSQL database and install requirements.txt.
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/npuarena

# Set these when the site is behind HTTPS and a reverse proxy.
# PUBLIC_ORIGIN=https://npuarena.example.com
# COOKIE_SECURE=true
# If a trusted reverse proxy runs on the same host, list its source IP(s).
# The app ignores X-Forwarded-For from all other clients.
# TRUSTED_PROXY_IPS=127.0.0.1

# Public registration is disabled by default. Administrator login does not
# require SMTP or Turnstile. To restore public registration in the future,
# explicitly enable it and configure HTTPS, SMTP, and Turnstile.
# PUBLIC_REGISTRATION_ENABLED=true
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_FROM=NPUTrainArena <no-reply@npuarena.example.com>
# SMTP_USER=no-reply@npuarena.example.com
# SMTP_PASSWORD=replace-with-app-password

# Create a Turnstile widget for the PUBLIC_ORIGIN hostname. The site key is
# sent to browsers; keep the secret key on the server only.
# TURNSTILE_SITE_KEY=replace-with-site-key
# TURNSTILE_SECRET_KEY=replace-with-secret-key
